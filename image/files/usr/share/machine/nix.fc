/nix/store/[^/]+/etc(/.*)?	system_u:object_r:etc_t:s0
/nix/store/[^/]+/share/man(/.*)?	system_u:object_r:man_t:s0
/nix/var(/.*)?	system_u:object_r:var_lib_t:s0
