[Unit]
Description=Return mostly empty btrfs data chunks to the unallocated pool
ConditionPathExists=/usr/bin/btrfs

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
ExecCondition=/usr/bin/sh -c 'test "$(stat -f -c %%T /var/home)" = btrfs'
ExecStart=/usr/bin/btrfs balance start -dusage=50 /var/home
